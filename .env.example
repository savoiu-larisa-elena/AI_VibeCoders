# Copy to .env and fill in. .env is git-ignored - never commit real keys.
# (Used later, when the LLM part is added.)
LLM_PROVIDER=groq
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional extra Groq keys - only add capacity if they come from ANOTHER Groq account
# (limits are per account). The app switches automatically when a limit is reached:
# Groq gpt-oss-20b -> Groq gpt-oss-120b -> extra Groq keys -> Gemini -> pre-written messages
GROQ_API_KEY_2=
# AI voice for spoken alerts (Groq Orpheus). Accept the model terms once in the Groq console.
TTS_VOICE=troy
